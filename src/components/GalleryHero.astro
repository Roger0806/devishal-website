---
import { getCollection } from 'astro:content';

const gallery = (await getCollection('gallery')).sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const artworkPositions = [
	{ className: 'artwork-a', spin: -170, slide: -90 },
	{ className: 'artwork-b', spin: 125, slide: 110 },
	{ className: 'artwork-c', spin: 210, slide: 150 },
	{ className: 'artwork-d', spin: -120, slide: -130 },
];
---
<section class="gallery-journey" aria-label="Interactieve galerie">
	<div class="gallery-stage">
		<div class="stage-label"><p class="kicker">De Vishal / Haarlem</p><h1>Ruimte<br>voor kunst.</h1></div>
		{gallery.map((item, index) => {
			const position = artworkPositions[index];
			return <figure class={`artwork ${position.className}`} data-spin={position.spin} data-slide={position.slide}><img src={item.data.image} alt={item.data.alt} decoding="async"><figcaption>{item.data.caption}</figcaption></figure>;
		})}
		<p class="stage-note">Scroll door de ruimte. De werken reageren op jouw beweging.</p><span class="scroll-mark">Beweeg</span>
	</div>
</section>