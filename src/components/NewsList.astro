---
import { getCollection } from 'astro:content';
const news = (await getCollection('news')).sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---
<section class="current" id="actueel">
	<div class="current-header"><h2>Actueel</h2><p>Wat er nu beweegt in en rond De Vishal.</p></div>
	<div class="news-list">
		{news.map((item) => {
			const d = new Date(item.data.date);
			const formatted = `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
			return (
				<article class="news-item">
					<time class="news-date" datetime={item.data.date}>{formatted}</time>
					<div>
						<h3>{item.data.title}</h3>
						<p>{item.data.description}</p>
					</div>
				</article>
			);
		})}
	</div>
</section>