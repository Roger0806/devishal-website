---
import { getCollection } from 'astro:content';

const paintings = (await getCollection('paintings')).sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const paintingDepths = { one: -1.2, two: 1, three: -1, four: 1.3, five: -.8, six: 1.1 };
---
<section class="members-journey" id="kunstenaars" aria-label="Kunstenaarsvereniging">
	<div class="members-stage">
		<div class="members-title"><p class="kicker">De kunstenaarsvereniging</p><h2>150 makers.<br>Een ruimte.</h2><p>Scroll door de wand en ontmoet de kunstenaars achter De Vishal.</p></div>
		{paintings.map((item) => <figure class={`painting ${item.data.className}`} data-depth={paintingDepths[item.data.className as keyof typeof paintingDepths]}><img src={item.data.image} alt={item.data.alt}><figcaption>{item.data.caption}</figcaption></figure>)}
		<article class="artist-card one"><span>01 / kunstenaar</span><h3>Adriane Bastiaens</h3><p>Een van de makers in THE THE, de actuele tentoonstelling in de grote zaal.</p></article>
		<article class="artist-card two"><span>02 / kunstenaar</span><h3>Kristina Benjocki</h3><p>Onderzoekt hoe taal, beeld en herinnering elkaar kunnen raken.</p></article>
		<article class="artist-card three"><span>03 / gemeenschap</span><h3>150 stemmen</h3><p>Van schilderkunst tot performance: samen vormen de leden het gezicht van De Vishal.</p><a class="inline-link" href="https://www.devishal.nl/leden/overzicht/">Bekijk alle kunstenaars &#8594;</a></article>
		<p class="members-progress">Scroll / 03</p>
	</div>
</section>
