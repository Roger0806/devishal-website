---
---
<html lang="nl">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="De Vishal in Haarlem: hedendaagse kunst en actuele tentoonstellingen.">
	<title>De Vishal | Hedendaagse kunst in Haarlem</title>
	<style is:global>
		:root { --ink: #171717; --paper: #f7f7f3; --acid: #d7f23a; --muted: #74746c; --line: #d6d6cf; }
		* { box-sizing: border-box; }
		html { scroll-behavior: smooth; }
		body { margin: 0; background: var(--paper); color: var(--ink); font-family: Arial, sans-serif; }
		a { color: inherit; }
		.site-header { position: absolute; top: 0; left: 0; z-index: 10; display: flex; justify-content: space-between; width: 100%; padding: 24px clamp(22px, 6vw, 90px); }
		.logo { font: 900 1.5rem/.9 Georgia, serif; letter-spacing: -.08em; text-decoration: none; text-transform: uppercase; }
		.logo span { color: #8ea800; }
		.site-menu { position: relative; }
		.menu-button { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 10px 16px; border: 1px solid var(--ink); border-radius: 4px; background: var(--paper); color: var(--ink); font: 700 .75rem Arial, sans-serif; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
		.menu-button:hover, .menu-button:focus-visible { background: var(--acid); }
		.menu-icon { display: grid; gap: 4px; width: 19px; }
		.menu-icon span { display: block; height: 2px; background: currentColor; }
		.menu-label { line-height: 1; }
		.menu-panel { position: absolute; top: calc(100% + 12px); right: 0; width: min(520px, calc(100vw - 44px)); max-height: calc(100vh - 100px); overflow-y: auto; padding: 26px clamp(22px, 4vw, 38px) 30px; border: 1px solid var(--ink); background: var(--paper); box-shadow: 0 22px 50px rgba(0,0,0,.2); }
		.menu-panel-heading { display: flex; align-items: start; justify-content: space-between; gap: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
		.menu-kicker { margin: 0; color: #819500; font-size: .68rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
		.menu-close { border: 0; background: transparent; color: var(--ink); font: 700 .72rem Arial, sans-serif; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
		.menu-close span { margin-left: 7px; font-size: 1.35rem; font-weight: 400; vertical-align: -2px; }
		.menu-list, .menu-list ul { padding: 0; margin: 0; list-style: none; }
		.menu-list > li { border-bottom: 1px solid var(--line); }
		.menu-list a { display: block; padding: 15px 0; font-size: 1.05rem; font-weight: 700; text-decoration: none; }
		.menu-list a:hover, .menu-list a:focus-visible, .menu-panel-footer a:hover, .menu-panel-footer a:focus-visible { color: #7e9300; }
		.menu-group > a { font-size: 1.35rem; }
		.menu-list ul { padding: 0 0 10px 18px; }
		.menu-list ul a { padding: 8px 0; color: var(--muted); font-size: .9rem; font-weight: 400; }
		.menu-panel-footer { display: flex; flex-wrap: wrap; gap: 18px 28px; padding-top: 24px; }
		.menu-panel-footer a { font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
		body.menu-is-open { overflow: hidden; }
		.gallery-journey { height: 220vh; }
		.gallery-stage { position: sticky; top: 0; display: flex; align-items: center; justify-content: center; height: 100vh; overflow: hidden; background: var(--paper); }
		.gallery-stage::before { content: ""; position: absolute; inset: 0; opacity: .5; background-image: radial-gradient(#c7c7bf .7px, transparent .7px); background-size: 18px 18px; mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent); }
		.stage-label { position: absolute; top: 27vh; left: clamp(22px, 8vw, 130px); z-index: 2; will-change: transform, opacity; }
		.kicker { margin: 0 0 16px; color: #819500; font-size: .68rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
		h1 { margin: 0; font: 400 clamp(4rem, 11vw, 10rem)/.8 Georgia, serif; letter-spacing: -.09em; }
		.stage-note { position: absolute; right: clamp(22px, 8vw, 130px); bottom: 12vh; z-index: 2; max-width: 190px; margin: 0; color: var(--muted); font-size: .8rem; line-height: 1.5; will-change: transform, opacity; }
		.scroll-mark { position: absolute; bottom: 7vh; z-index: 3; font-size: .65rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; will-change: opacity; }
		.scroll-mark::after { content: " ↓"; font-size: 1.2rem; }
		.artwork { position: absolute; z-index: 3; width: clamp(145px, 20vw, 270px); padding: 10px; background: #fff; box-shadow: 0 25px 55px rgba(36,36,30,.2); will-change: transform, opacity; transform: translate3d(var(--x), var(--y), 0) rotate(var(--r)); }
		.artwork img { display: block; width: 100%; height: auto; object-fit: contain; }
		.artwork figcaption { position: absolute; top: calc(100% + 9px); left: 0; color: var(--muted); font-size: .65rem; }
		.artwork-a { --x: -22vw; --y: -24vh; --r: -12deg; }
		.artwork-b { --x: 13vw; --y: -30vh; --r: 8deg; width: clamp(175px, 24vw, 320px); }
		.artwork-c { --x: 25vw; --y: 18vh; --r: -9deg; width: clamp(135px, 17vw, 235px); }
		.artwork-d { --x: -23vw; --y: 23vh; --r: 7deg; width: clamp(125px, 16vw, 220px); }
		.exhibitions { padding: 110px clamp(22px, 8vw, 130px) 130px; background: var(--paper); }
		.exhibitions-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
		.exhibitions-heading h2 { margin: 0; font: 400 clamp(3rem, 7vw, 7rem)/.84 Georgia, serif; letter-spacing: -.08em; }
		.exhibitions-heading p { max-width: 230px; margin: 0; color: var(--muted); font-size: .85rem; line-height: 1.5; }
		.exhibition-list { display: grid; grid-template-columns: repeat(3, 1fr); }
		.exhibition-card { min-height: 320px; padding: 28px 24px 30px 0; border-bottom: 1px solid var(--line); }
		.exhibition-card + .exhibition-card { padding-left: 24px; border-left: 1px solid var(--line); }
		.exhibition-number { color: #8ea800; font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
		.exhibition-card h3 { margin: 62px 0 16px; font: 400 clamp(1.8rem, 3vw, 3.2rem)/.9 Georgia, serif; letter-spacing: -.06em; }
		.exhibition-card p { max-width: 330px; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.6; }
		.exhibition-card .meta { margin-top: 24px; color: var(--ink); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
		.exhibition-card a { display: inline-block; margin-top: 24px; font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
		.exhibition-card a:hover { color: #7e9300; }
		.about-band { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 10vw, 160px); padding: 120px clamp(22px, 8vw, 130px); border-top: 1px solid var(--line); }
		.about-band h2, .support h2 { margin: 0; font: 400 clamp(2.8rem, 6vw, 6.5rem)/.86 Georgia, serif; letter-spacing: -.08em; }
		.about-copy { align-self: end; max-width: 450px; }
		.about-copy p { margin: 0 0 28px; color: var(--muted); font-size: 1.05rem; line-height: 1.7; }
		.inline-link { font-size: .68rem; font-weight: 700; letter-spacing: .13em; text-decoration: none; text-transform: uppercase; }
		.inline-link:hover { color: #7e9300; }
		.current { padding: 100px clamp(22px, 8vw, 130px); background: #e9e9e2; }
		.current-header { display: flex; align-items: end; justify-content: space-between; gap: 30px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
		.current-header h2 { margin: 0; font: 400 clamp(2.6rem, 5vw, 5rem)/.85 Georgia, serif; letter-spacing: -.08em; }
		.current-header p { margin: 0; color: var(--muted); font-size: .85rem; }
		.news-list { display: grid; grid-template-columns: repeat(2, 1fr); }
		.news-item { display: grid; grid-template-columns: 100px 1fr; gap: 25px; padding: 28px 20px 28px 0; border-bottom: 1px solid var(--line); }
		.news-item + .news-item { padding-left: 20px; border-left: 1px solid var(--line); }
		.news-date { color: #8ea800; font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
		.news-item h3 { margin: 0 0 10px; font: 400 clamp(1.5rem, 2.5vw, 2.5rem)/.95 Georgia, serif; letter-spacing: -.05em; }
		.news-item p { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.55; }
		.members-journey { height: 260vh; background: var(--ink); }
		.members-stage { position: sticky; top: 0; height: 100vh; min-height: 650px; overflow: hidden; background: #d9d9d1; }
		.members-stage::before { content: ""; position: absolute; inset: 0; opacity: .45; background-image: linear-gradient(rgba(30,30,27,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(30,30,27,.08) 1px, transparent 1px); background-size: 40px 40px; }
		.members-title { position: absolute; top: 10vh; left: clamp(22px, 8vw, 130px); z-index: 5; }
		.members-title h2 { margin: 0; color: #fff; font: 400 clamp(3rem, 7vw, 7rem)/.84 Georgia, serif; letter-spacing: -.08em; text-shadow: 0 2px 16px rgba(0,0,0,.35); }
		.members-title p:not(.kicker) { max-width: 230px; margin: 20px 0 0; color: #fff; font-size: .85rem; line-height: 1.5; text-shadow: 0 1px 8px rgba(0,0,0,.45); }
		.painting { position: absolute; z-index: 2; width: clamp(130px, 17vw, 230px); padding: 9px; background: #fff; box-shadow: 0 22px 42px rgba(0,0,0,.25); will-change: transform, opacity; }
		.painting img { display: block; width: 100%; height: auto; object-fit: contain; }
		.painting figcaption { position: absolute; top: calc(100% + 7px); left: 0; color: #44443f; font-size: .62rem; }
		.painting.one { top: 8%; left: 4%; transform: rotate(-12deg); }
		.painting.two { top: 13%; left: 28%; width: clamp(150px, 20vw, 280px); transform: rotate(7deg); }
		.painting.three { top: 8%; right: 5%; transform: rotate(11deg); }
		.painting.four { bottom: 8%; left: 7%; transform: rotate(8deg); }
		.painting.five { right: 28%; bottom: 7%; width: clamp(150px, 19vw, 260px); transform: rotate(-6deg); }
		.painting.six { right: 4%; bottom: 12%; transform: rotate(-13deg); }
		.artist-card { position: absolute; z-index: 4; width: min(330px, 30vw); padding: 22px; background: var(--paper); box-shadow: 0 18px 35px rgba(0,0,0,.18); opacity: 0; will-change: transform, opacity; }
		.artist-card.one { top: 34%; left: 34%; }
		.artist-card.two { top: 38%; right: 28%; }
		.artist-card.three { top: 31%; left: 39%; }
		.artist-card h3 { margin: 0 0 8px; font: 400 2rem/.9 Georgia, serif; letter-spacing: -.06em; }
		.artist-card p { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.55; }
		.artist-card span { display: block; margin-bottom: 22px; color: #8ea800; font-size: .65rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
		.members-progress { position: absolute; right: clamp(22px, 8vw, 130px); bottom: 8vh; z-index: 5; color: #fff; font-size: .68rem; letter-spacing: .13em; text-shadow: 0 1px 8px rgba(0,0,0,.45); text-transform: uppercase; }
		.support { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 10vw, 150px); padding: 110px clamp(22px, 8vw, 130px); background: var(--acid); }
		.support-copy { align-self: end; max-width: 420px; }
		.support-copy p { margin: 0 0 25px; font-size: 1rem; line-height: 1.7; }
		.support-links { display: grid; gap: 14px; align-content: end; }
		.support-links a { display: flex; justify-content: space-between; padding: 15px 0; border-bottom: 1px solid rgba(23,23,23,.35); font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-decoration: none; text-transform: uppercase; }
		.support-links a:hover { padding-left: 10px; }
		.newsletter { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding: 35px clamp(22px, 8vw, 130px); background: var(--ink); color: var(--paper); }
		.newsletter p { margin: 0; color: #b8b8af; font-size: .9rem; }
		.newsletter a { color: var(--acid); font-size: .7rem; font-weight: 700; letter-spacing: .13em; text-decoration: none; text-transform: uppercase; }
		.site-footer { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 40px; padding: 70px clamp(22px, 8vw, 130px) 80px; border-top: 1px solid var(--line); background: #ededE7; }
		.footer-block h2 { margin: 0 0 20px; font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; }
		.footer-block p, .footer-block address { margin: 0; color: var(--muted); font-size: .9rem; font-style: normal; line-height: 1.7; }
		.footer-block a { text-decoration: none; }
		.footer-block a:hover { color: #7e9300; }
		.footer-links { display: grid; gap: 8px; }
		@media (max-width: 760px) {
			.site-header { padding-top: 18px; }
			.menu-panel { position: fixed; top: 82px; right: 22px; left: 22px; width: auto; max-height: calc(100vh - 104px); }
			.menu-panel-heading { gap: 12px; }
			.menu-kicker { max-width: 150px; line-height: 1.4; }
			.menu-list a { overflow-wrap: anywhere; }
			.menu-group > a { font-size: 1.2rem; }
			.menu-list ul { padding-left: 12px; }
			.menu-list ul a { font-size: .88rem; }
			.menu-panel-footer { gap: 14px 20px; }
			.stage-label { top: 20vh; }
			.stage-note { right: 22px; max-width: 150px; font-size: .75rem; }
			.artwork { width: 125px; }
			.artwork-a { --x: -27vw; --y: -6vh; }
			.artwork-b { --x: 25vw; --y: 0vh; width: 155px; }
			.artwork-c { --x: 24vw; --y: 22vh; width: 130px; }
			.artwork-d { --x: -25vw; --y: 24vh; width: 120px; }
			.exhibitions-heading { align-items: start; flex-direction: column; }
			.exhibition-list { grid-template-columns: 1fr; }
			.exhibition-card, .exhibition-card + .exhibition-card { min-height: auto; padding: 28px 0; border-left: 0; }
			.site-footer { grid-template-columns: 1fr; gap: 36px; }
			.about-band, .support { grid-template-columns: 1fr; gap: 50px; }
			.members-stage { min-height: 590px; }
			.members-title { top: 12vh; }
			.painting { width: 145px; }
			.painting.two, .painting.five { width: 165px; }
			.artist-card { width: min(250px, 60vw); }
			.artist-card.one { top: 38%; left: 8%; }
			.artist-card.two { top: 43%; right: 7%; }
			.artist-card.three { top: 37%; left: 22%; }
			.current-header { align-items: start; flex-direction: column; }
			.news-list { grid-template-columns: 1fr; }
			.news-item, .news-item + .news-item { grid-template-columns: 85px 1fr; padding: 24px 0; border-left: 0; }
			.newsletter { align-items: start; flex-direction: column; }
		}
	</style>
</head>
<body>
	<slot />
</body>
</html>